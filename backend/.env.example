# Copy to `.env` in this directory (`cp .env.example .env`) and adjust values.
# Never commit `.env` — it is listed in `.gitignore`.

# Required for POST /api/submit-stats (Bearer token must match exactly).
STATS_API_TOKEN=change-me

# SQLite database file (relative paths are resolved from the process working directory).
DATABASE_URL=sqlite:///./etl_stats.db

# Comma-separated browser origins allowed for CORS (dev + optional alternate Vite ports).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5180,http://localhost:5180

# SR Dampening
BALANCER_DAMPENING_THRESHOLD=3000
BALANCER_DAMPENING_FACTOR=0.5
BALANCER_NOISE=150

# Comma-separated whitelist of base RCON commands allowed by the /api/server/change-map endpoint.
# Default: ref,map_restart,map
# Example to add extra commands: RCON_ALLOWED_MAP_COMMANDS=ref,map_restart,map,devmap
# RCON_ALLOWED_MAP_COMMANDS=ref,map_restart,map
